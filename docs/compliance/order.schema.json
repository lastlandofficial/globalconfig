{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/text"
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "jurisdiction": {
      "$ref": "#/$defs/text"
    },
    "buyer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "country": {
          "enum": [
            "IN",
            "JP",
            "US"
          ]
        },
        "address": {
          "$ref": "#/$defs/text"
        },
        "registrationId": {
          "$ref": "#/$defs/text"
        },
        "stateCode": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "name",
        "country"
      ]
    },
    "scenario": {
      "enum": [
        "ordinary-domestic",
        "cross-border",
        "reverse-charge",
        "marketplace",
        "special"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "productId": {
            "$ref": "#/$defs/text"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              {
                "$ref": "#/$defs/positiveQuantity"
              }
            ],
            "description": "Integer quantities are always supported. Decimal strings require a reviewed billing policy; runtime applies its configured precision. Duplicate line IDs and currency precision are checked at runtime."
          },
          "discount": {
            "$ref": "#/$defs/nonnegativeDecimal"
          }
        },
        "required": [
          "id",
          "productId",
          "quantity"
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "discount": {
      "$ref": "#/$defs/nonnegativeDecimal"
    },
    "pricing": {
      "enum": [
        "inclusive",
        "exclusive"
      ]
    },
    "supply": {
      "enum": [
        "intra-state",
        "inter-state"
      ]
    },
    "localTax": {
      "enum": [
        "SGST",
        "UTGST"
      ]
    },
    "placeOfSupply": {
      "$ref": "#/$defs/text"
    }
  },
  "required": [
    "id",
    "date",
    "jurisdiction",
    "buyer",
    "scenario",
    "lines",
    "pricing"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "glocon transaction",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.7.0/docs/compliance/order.schema.json",
  "description": "Structural and lexical validation for a transaction. Runtime additionally validates duplicate IDs, configured currency precision, and the presence and precision of a reviewed billing policy for string quantities.",
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonnegativeDecimal": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*[0-9]{1,30}(?:\\.[0-9]{1,18}0*)?$",
      "description": "Unsigned plain decimal string, below 1e30, with at most 18 significant fractional places (trailing zeros do not add precision). Currency or reviewed unit-price precision is validated at runtime."
    },
    "positiveQuantity": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*(?:[0-9]{1,6}(?:\\.[0-9]{1,18}0*)?|1000000(?:\\.0+)?)$",
      "not": {
        "pattern": "^0+(?:\\.0+)?$",
        "type": "string"
      },
      "description": "Positive unsigned plain decimal quantity no greater than 1000000. String quantities require a reviewed billing policy; its quantityPrecision is enforced at runtime."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "description": "At most 10000 Unicode characters, including at least one non-whitespace character."
    }
  }
}
