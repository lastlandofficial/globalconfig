{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "business": {
      "$ref": "#/$defs/business"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "treatments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treatment"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "version",
        "revision",
        "requirements",
        "treatments"
      ]
    },
    "rounding": {
      "enum": [
        "half-up",
        "half-even",
        "down",
        "up"
      ]
    }
  },
  "required": [
    "version",
    "business",
    "products",
    "rules",
    "rounding"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.6.0/docs/compliance/config.schema.json",
  "title": "glocon compliance configuration",
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "format": "date"
        },
        "after": {
          "type": "string",
          "format": "date"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "by",
        "on",
        "after",
        "reference"
      ]
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "enum": [
            "IN",
            "JP",
            "US"
          ]
        },
        "environment": {
          "enum": [
            "test",
            "production"
          ]
        },
        "registration": {
          "enum": [
            "registered",
            "unregistered",
            "unknown"
          ]
        },
        "registrationId": {
          "type": "string",
          "minLength": 1
        },
        "stateCode": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "invoiceSeries": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,3}$"
        },
        "india": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eInvoice": {
              "enum": [
                "required",
                "not-required",
                "unknown"
              ]
            },
            "signature": {
              "enum": [
                "required",
                "electronic-exception",
                "unknown"
              ]
            },
            "declaration": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "eInvoice",
            "signature"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "country",
        "environment",
        "registration",
        "invoiceSeries"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "unitPrice": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description",
        "unitPrice"
      ]
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "enum": [
            "taxable",
            "zero-rated",
            "exempt",
            "out-of-scope"
          ]
        },
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date"
        },
        "effectiveTo": {
          "type": "string",
          "format": "date"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "productId",
        "jurisdiction",
        "treatment",
        "rate",
        "effectiveFrom",
        "review"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "enum": [
            "IN",
            "JP",
            "US"
          ]
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "provision": {
          "type": "string",
          "minLength": 1
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "reviewAfter": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "country",
        "source",
        "provision",
        "reviewedOn",
        "reviewAfter",
        "scope"
      ]
    }
  }
}
