{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.7.0/docs/compliance/financial-cases.schema.json",
  "title": "glocon exact financial fixtures",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "order",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "order": {
        "$ref": "./order.schema.json"
      },
      "details": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "issuedOn"
        ],
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1
          },
          "issuedOn": {
            "type": "string",
            "format": "date"
          },
          "signatureEvidence": {
            "type": "string",
            "minLength": 1
          },
          "externalRegistration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "irn",
              "signedQR",
              "evidence",
              "verifiedBy",
              "verifiedOn"
            ],
            "properties": {
              "irn": {
                "type": "string",
                "minLength": 1
              },
              "signedQR": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "verifiedBy": {
                "type": "string",
                "minLength": 1
              },
              "verifiedOn": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "needs-context",
              "unsupported",
              "invalid"
            ]
          },
          "net": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
          },
          "tax": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
          },
          "gross": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
          },
          "issueCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "required": [
                "net",
                "tax",
                "gross"
              ],
              "not": {
                "required": [
                  "issueCodes"
                ]
              }
            },
            "else": {
              "required": [
                "issueCodes"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "net"
                    ]
                  },
                  {
                    "required": [
                      "tax"
                    ]
                  },
                  {
                    "required": [
                      "gross"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
