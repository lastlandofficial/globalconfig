{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/main/docs/ui/report.schema.json",
  "title": "glocon audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engineVersion",
    "source",
    "findings",
    "suppressed",
    "summary",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "engineVersion": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "reason"
        ],
        "properties": {
          "finding": {
            "$ref": "#/$defs/finding"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "warning",
        "info",
        "total"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "elements",
        "limitations"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "ruleId",
        "severity",
        "confidence",
        "category",
        "message",
        "target",
        "evidence",
        "suggestion"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^glocon-[0-9a-f]{8}$"
        },
        "ruleId": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium"
          ]
        },
        "category": {
          "enum": [
            "accessibility",
            "layout",
            "consistency",
            "ux"
          ]
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "helpUrl": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        }
      }
    }
  }
}
