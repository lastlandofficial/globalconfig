{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.5.0/docs/ui/check-config.schema.json",
  "title": "glocon project checks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseURL",
    "pages",
    "viewports"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "baseURL": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "description": "HTTP(S) origin with no path, credentials, query, or fragment."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/[^/]*",
                "description": "A path on baseURL. Supply real examples for dynamic routes."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Non-sensitive display name for this page."
              },
              "auth": {
                "type": "boolean",
                "description": "Require auth.storageState and verify auth.readySelector before auditing."
              },
              "readySelector": {
                "type": "string",
                "minLength": 1,
                "description": "Wait for this CSS selector to be visible before auditing."
              },
              "scenarios": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/scenario"
                },
                "description": "Each named scenario runs in an isolated context at every viewport; replaces the plain page check."
              }
            }
          }
        ]
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "name",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      }
    },
    "webServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "Trusted local command to start the application."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "reuseExistingServer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageState",
        "readySelector"
      ],
      "properties": {
        "storageState": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a gitignored Playwright test storage-state file."
        },
        "readySelector": {
          "type": "string",
          "minLength": 1,
          "description": "Visible marker specific to a successfully authenticated page."
        },
        "loginPath": {
          "type": "string",
          "minLength": 1
        },
        "setupCommand": {
          "type": "string",
          "minLength": 1,
          "description": "Existing test-login command, run once after the app is ready."
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readySelector": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "maxElements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "accessibility": {
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          }
        },
        "spacingScale": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "spacingTolerance": {
          "type": "number",
          "minimum": 0
        },
        "targetSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "reason"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "failOn": {
      "enum": [
        "error",
        "warning",
        "info",
        "none"
      ],
      "default": "error"
    },
    "screenshots": {
      "type": "boolean",
      "default": true,
      "description": "Save local highlighted viewport screenshots. They may contain app content."
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector"
          ],
          "properties": {
            "action": {
              "const": "click"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector",
            "value"
          ],
          "properties": {
            "action": {
              "const": "fill"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector",
            "key"
          ],
          "properties": {
            "action": {
              "const": "press"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector",
            "state"
          ],
          "properties": {
            "action": {
              "const": "expect"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "visible",
                "hidden",
                "enabled",
                "disabled",
                "focused"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector",
            "text"
          ],
          "properties": {
            "action": {
              "const": "expect"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "selector",
            "value"
          ],
          "properties": {
            "action": {
              "const": "expect"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "mock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "responses"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^?#\\\\]*$",
          "description": "Exact same-origin pathname. Query strings on requests are ignored."
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ],
          "default": "GET"
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pending"
                ],
                "properties": {
                  "pending": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "status": {
                    "type": "integer",
                    "anyOf": [
                      {
                        "minimum": 200,
                        "maximum": 299
                      },
                      {
                        "minimum": 400,
                        "maximum": 599
                      }
                    ]
                  },
                  "json": {}
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            204,
                            205
                          ]
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "json"
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "HEAD"
              }
            }
          },
          "then": {
            "properties": {
              "responses": {
                "items": {
                  "not": {
                    "required": [
                      "json"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "readySelector": {
          "type": "string",
          "minLength": 1
        },
        "mocks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/mock"
          }
        }
      }
    }
  }
}
