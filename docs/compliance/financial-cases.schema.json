{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.7.0/docs/compliance/financial-cases.schema.json",
  "title": "glocon exact financial fixtures",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "order",
      "expected"
    ],
    "properties": {
      "name": {
        "$ref": "#/$defs/text"
      },
      "order": {
        "description": "Must satisfy the transaction schema unless this case explicitly expects invalid input."
      },
      "details": {
        "description": "Must satisfy invoiceDetails unless this case explicitly expects invalid input."
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "needs-context",
              "unsupported",
              "invalid"
            ]
          },
          "net": {
            "$ref": "#/$defs/nonnegativeDecimal"
          },
          "tax": {
            "$ref": "#/$defs/nonnegativeDecimal"
          },
          "gross": {
            "$ref": "#/$defs/nonnegativeDecimal"
          },
          "issueCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            },
            "maxItems": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "required": [
                "net",
                "tax",
                "gross"
              ],
              "not": {
                "required": [
                  "issueCodes"
                ]
              }
            },
            "else": {
              "required": [
                "issueCodes"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "net"
                    ]
                  },
                  {
                    "required": [
                      "tax"
                    ]
                  },
                  {
                    "required": [
                      "gross"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "expected": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "invalid"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "required": [
            "expected"
          ]
        },
        "else": {
          "properties": {
            "order": {
              "$ref": "./order.schema.json"
            },
            "details": {
              "$ref": "#/$defs/invoiceDetails"
            }
          }
        }
      }
    ]
  },
  "description": "Complete exact financial acceptance fixtures. Runtime additionally checks unique case names, currency precision, selected quote/invoice coverage, and expected results. Schema validation cannot establish arithmetic correctness or review readiness. Cases expecting invalid may deliberately contain malformed order or invoice details; all fixture names and expectations remain validated.",
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonnegativeDecimal": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*[0-9]{1,30}(?:\\.[0-9]{1,18}0*)?$",
      "description": "Unsigned plain decimal string, below 1e30, with at most 18 significant fractional places (trailing zeros do not add precision). Currency or reviewed unit-price precision is validated at runtime."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "description": "At most 10000 Unicode characters, including at least one non-whitespace character."
    },
    "invoiceDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "issuedOn"
      ],
      "properties": {
        "number": {
          "$ref": "#/$defs/text"
        },
        "issuedOn": {
          "$ref": "#/$defs/date"
        },
        "signatureEvidence": {
          "$ref": "#/$defs/text"
        },
        "externalRegistration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "irn",
            "signedQR",
            "evidence",
            "verifiedBy",
            "verifiedOn"
          ],
          "properties": {
            "irn": {
              "$ref": "#/$defs/text"
            },
            "signedQR": {
              "$ref": "#/$defs/text"
            },
            "evidence": {
              "$ref": "#/$defs/text"
            },
            "verifiedBy": {
              "$ref": "#/$defs/text"
            },
            "verifiedOn": {
              "$ref": "#/$defs/date"
            }
          }
        }
      }
    }
  }
}
