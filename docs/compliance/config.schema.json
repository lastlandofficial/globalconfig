{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "#/$defs/text"
    },
    "version": {
      "const": 1
    },
    "business": {
      "$ref": "#/$defs/business"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "treatments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treatment"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "version",
        "revision",
        "requirements",
        "treatments"
      ]
    },
    "rounding": {
      "enum": [
        "half-up",
        "half-even",
        "down",
        "up"
      ]
    },
    "indiaRounding": {
      "enum": [
        "components",
        "combined"
      ]
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantityPrecision",
        "unitPricePrecision",
        "lineRounding",
        "review"
      ],
      "properties": {
        "quantityPrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "unitPricePrecision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "lineRounding": {
          "enum": [
            "half-up",
            "half-even",
            "down",
            "up"
          ]
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  },
  "required": [
    "version",
    "business",
    "products",
    "rules",
    "rounding"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lastlandofficial/globalconfig/glocon-v0.7.0/docs/compliance/config.schema.json",
  "title": "glocon compliance configuration",
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/text"
        },
        "on": {
          "$ref": "#/$defs/date"
        },
        "after": {
          "$ref": "#/$defs/date"
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "appliesFrom": {
          "$ref": "#/$defs/date",
          "description": "First covered transaction date. Defaults to on. Can precede the review date for explicitly reviewed historical transactions; must be earlier than after."
        }
      },
      "required": [
        "by",
        "on",
        "after",
        "reference"
      ],
      "description": "The review occurred on on. Covered transactions begin at appliesFrom (or on when omitted) and end before after. Date ordering is validated at runtime."
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "address": {
          "$ref": "#/$defs/text"
        },
        "country": {
          "enum": [
            "IN",
            "JP",
            "US"
          ]
        },
        "environment": {
          "enum": [
            "test",
            "production"
          ]
        },
        "registration": {
          "enum": [
            "registered",
            "unregistered",
            "unknown"
          ]
        },
        "registrationId": {
          "$ref": "#/$defs/text"
        },
        "stateCode": {
          "$ref": "#/$defs/text"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "invoiceSeries": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,3}$"
        },
        "india": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eInvoice": {
              "enum": [
                "required",
                "not-required",
                "unknown"
              ]
            },
            "signature": {
              "enum": [
                "required",
                "electronic-exception",
                "unknown"
              ]
            },
            "declaration": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "eInvoice",
            "signature"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "country",
        "environment",
        "registration",
        "invoiceSeries"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "unitPrice": {
          "$ref": "#/$defs/nonnegativeDecimal"
        },
        "classification": {
          "$ref": "#/$defs/text"
        },
        "unit": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "description",
        "unitPrice"
      ]
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "productId": {
          "$ref": "#/$defs/text"
        },
        "jurisdiction": {
          "$ref": "#/$defs/text"
        },
        "treatment": {
          "enum": [
            "taxable",
            "zero-rated",
            "exempt",
            "out-of-scope"
          ]
        },
        "rate": {
          "$ref": "#/$defs/rate"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        },
        "effectiveTo": {
          "$ref": "#/$defs/date"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "productId",
        "jurisdiction",
        "treatment",
        "rate",
        "effectiveFrom",
        "review"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "treatment": {
                "const": "taxable"
              }
            },
            "required": [
              "treatment"
            ]
          },
          "then": {
            "properties": {
              "rate": {
                "not": {
                  "$ref": "#/$defs/zeroDecimal"
                }
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "rate": {
                "$ref": "#/$defs/zeroDecimal"
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "country": {
          "enum": [
            "IN",
            "JP",
            "US"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "format": "uri",
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"
            }
          ],
          "description": "Absolute HTTPS source URL. Runtime also checks URL validity and source-monitor policy.",
          "type": "string"
        },
        "provision": {
          "$ref": "#/$defs/text"
        },
        "reviewedOn": {
          "$ref": "#/$defs/date"
        },
        "reviewAfter": {
          "$ref": "#/$defs/date"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "reviewAppliesFrom": {
          "$ref": "#/$defs/date",
          "description": "First covered transaction date. Defaults to reviewedOn. Must precede reviewAfter; runtime validates date ordering."
        }
      },
      "required": [
        "id",
        "title",
        "country",
        "source",
        "provision",
        "reviewedOn",
        "reviewAfter",
        "scope"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S",
      "description": "At most 10000 Unicode characters, including at least one non-whitespace character."
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonnegativeDecimal": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*[0-9]{1,30}(?:\\.[0-9]{1,18}0*)?$",
      "description": "Unsigned plain decimal string, below 1e30, with at most 18 significant fractional places (trailing zeros do not add precision). Currency or reviewed unit-price precision is validated at runtime."
    },
    "rate": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*(?:[0-9]{1,2}(?:\\.[0-9]{1,18}0*)?|100(?:\\.0+)?)$",
      "description": "Unsigned plain decimal percentage from 0 through 100, with at most 18 significant fractional places."
    },
    "zeroDecimal": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0+(?:\\.0+)?$"
    },
    "positiveQuantity": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^0*(?:[0-9]{1,6}(?:\\.[0-9]{1,18}0*)?|1000000(?:\\.0+)?)$",
      "not": {
        "pattern": "^0+(?:\\.0+)?$",
        "type": "string"
      },
      "description": "Positive unsigned plain decimal quantity no greater than 1000000. String quantities require a reviewed billing policy; its quantityPrecision is enforced at runtime."
    }
  },
  "description": "Structural and lexical validation for new financial configurations. Runtime additionally checks date ordering, unique IDs, product references, country-specific settings, and currency or billing-policy precision. Historical calculation engines retain their original replay validators.",
  "allOf": [
    {
      "if": {
        "properties": {
          "business": {
            "properties": {
              "country": {
                "const": "IN"
              }
            },
            "required": [
              "country"
            ],
            "type": "object"
          }
        },
        "required": [
          "business"
        ]
      },
      "else": {
        "not": {
          "required": [
            "indiaRounding"
          ]
        },
        "properties": {
          "business": {
            "not": {
              "required": [
                "india"
              ]
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
